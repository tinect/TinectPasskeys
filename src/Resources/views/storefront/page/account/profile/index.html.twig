{% sw_extends '@Storefront/storefront/page/account/profile/index.html.twig' %}

{% block page_account_profile_mail_and_password %}
    {{ parent() }}

    {% block page_account_profile_passkeys %}
        {# the passkeys are managed on their own account page, the id keeps older links with "#tinect-passkeys" working #}
        <div class="card account-profile-passkeys mb-4" id="tinect-passkeys">
            <div class="card-body">
                {% block page_account_profile_passkeys_title %}
                    <div class="card-title">
                        {{ 'tinect-passkeys.profile.title'|trans|sw_sanitize }}
                    </div>
                {% endblock %}

                {% block page_account_profile_passkeys_description %}
                    <p>{{ 'tinect-passkeys.profile.hint'|trans|sw_sanitize }}</p>
                {% endblock %}

                {% block page_account_profile_passkeys_link %}
                    <a href="{{ path('frontend.tinect-passkeys.page') }}" class="btn btn-outline-primary">
                        {{ 'tinect-passkeys.profile.manage'|trans|sw_sanitize }}
                    </a>
                {% endblock %}
            </div>
        </div>
    {% endblock %}
{% endblock %}
