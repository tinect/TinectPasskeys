{% sw_extends '@Storefront/storefront/page/account/_page.html.twig' %}

{% block page_account_main_content %}
    {% block page_account_passkeys %}
        <div class="account-passkeys">
            {% block page_account_passkeys_welcome %}
                <div class="account-welcome">
                    {% block page_account_passkeys_welcome_headline %}
                        <h1>{{ 'tinect-passkeys.profile.title'|trans|sw_sanitize }}</h1>
                    {% endblock %}

                    {% block page_account_passkeys_welcome_intro %}
                        <p>{{ 'tinect-passkeys.profile.description'|trans|sw_sanitize }}</p>
                    {% endblock %}
                </div>
            {% endblock %}

            {% block page_account_passkeys_content %}
                {% set tinectPasskeys = page.passkeys %}
                {% set tinectPasswordLoginDisabled = page.passwordLoginDisabled %}
                {% set tinectPasskeyConfirmOptions = {
                    optionsUrl: path('frontend.tinect-passkeys.confirm.options'),
                    errorMessage: 'tinect-passkeys.passwordLogin.errorConfirmation'|trans|striptags,
                    notAllowedMessage: 'tinect-passkeys.passwordLogin.errorNotAllowed'|trans|striptags,
                    unsupportedMessage: 'tinect-passkeys.register.unsupported'|trans|striptags,
                } %}

                <div class="card account-passkeys-card mb-4" id="tinect-passkeys">
                    <div class="card-body">
                        {% block page_account_passkeys_list_header %}
                            <h2 class="card-title d-flex flex-wrap align-items-baseline gap-2">
                                {{ 'tinect-passkeys.profile.listTitle'|trans|sw_sanitize }}

                                {% if tinectPasskeys is not empty %}
                                    <span class="small text-muted fw-normal">
                                        {{ 'tinect-passkeys.profile.count'|trans({ '%count%': tinectPasskeys|length })|sw_sanitize }}
                                    </span>
                                {% endif %}
                            </h2>
                        {% endblock %}

                        {% block page_account_passkeys_list %}
                            {% if tinectPasskeys is not empty %}
                                <ul class="list-group mb-4">
                                    {% for passkey in tinectPasskeys %}
                                        {% block page_account_passkeys_list_item %}
                                            <li class="list-group-item d-flex align-items-center gap-3 py-3">
                                                <span class="d-inline-flex align-items-center justify-content-center flex-shrink-0 rounded-circle bg-primary-subtle text-primary"
                                                      style="width: 2.5rem; height: 2.5rem;"
                                                      aria-hidden="true">
                                                    {% sw_icon 'lock-key' style { size: 'sm', color: 'primary' } %}
                                                </span>

                                                <div class="flex-grow-1" style="min-width: 0;">
                                                    <strong class="d-block text-break">{{ passkey.name }}</strong>
                                                    <div class="small text-muted">
                                                        {{ 'tinect-passkeys.profile.createdAt'|trans|sw_sanitize }}
                                                        {{ passkey.createdAt|format_date('medium', locale=app.request.locale) }}
                                                        {% if passkey.lastUsedAt %}
                                                            &middot;
                                                            {{ 'tinect-passkeys.profile.lastUsedAt'|trans|sw_sanitize }}
                                                            {{ passkey.lastUsedAt|format_datetime('medium', 'short', locale=app.request.locale) }}
                                                        {% endif %}
                                                    </div>
                                                </div>

                                                <button type="button"
                                                        class="btn btn-link link-danger text-decoration-none fw-semibold flex-shrink-0"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#tinectPasskeyDeleteModal-{{ passkey.id }}"
                                                        title="{{ 'tinect-passkeys.profile.delete'|trans|striptags }}">
                                                    {{ 'tinect-passkeys.profile.delete'|trans|sw_sanitize }}
                                                </button>
                                            </li>
                                        {% endblock %}
                                    {% endfor %}
                                </ul>

                                {% for passkey in tinectPasskeys %}
                                    {% block page_account_passkeys_delete_modal %}
                                        <div class="modal fade"
                                             id="tinectPasskeyDeleteModal-{{ passkey.id }}"
                                             tabindex="-1"
                                             aria-labelledby="tinectPasskeyDeleteModalTitle-{{ passkey.id }}"
                                             aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h2 class="modal-title h5" id="tinectPasskeyDeleteModalTitle-{{ passkey.id }}">
                                                            {{ 'tinect-passkeys.delete.confirmTitle'|trans|sw_sanitize }}
                                                        </h2>
                                                        <button type="button"
                                                                class="btn-close"
                                                                data-bs-dismiss="modal"
                                                                aria-label="{{ 'global.default.close'|trans|striptags }}"></button>
                                                    </div>

                                                    <div class="modal-body">
                                                        {{ 'tinect-passkeys.delete.confirmText'|trans({ '%name%': passkey.name|e })|raw }}

                                                        {% if tinectPasswordLoginDisabled %}
                                                            <p class="mt-2 mb-0 small text-muted">{{ 'tinect-passkeys.passwordLogin.confirmWithPasskey'|trans|sw_sanitize }}</p>
                                                            <div class="tinect-passkey-confirm-error alert alert-danger mt-3 mb-0 d-none" role="alert"></div>
                                                        {% endif %}
                                                    </div>

                                                    <div class="modal-footer">
                                                        <button type="button"
                                                                class="btn btn-secondary"
                                                                data-bs-dismiss="modal">
                                                            {{ 'tinect-passkeys.delete.cancel'|trans|sw_sanitize }}
                                                        </button>

                                                        {# with a disabled password login, removing a passkey has to be confirmed with a passkey #}
                                                        <form action="{{ path('frontend.tinect-passkeys.delete', { passkeyId: passkey.id }) }}"
                                                              method="post"
                                                              {% if tinectPasswordLoginDisabled %}
                                                              data-tinect-passkey-confirm="true"
                                                              data-tinect-passkey-confirm-options="{{ tinectPasskeyConfirmOptions|json_encode }}"
                                                              {% endif %}>
                                                            <button type="submit" class="btn btn-danger">
                                                                {{ 'tinect-passkeys.delete.confirm'|trans|sw_sanitize }}
                                                            </button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    {% endblock %}
                                {% endfor %}
                            {% else %}
                                {% block page_account_passkeys_list_empty %}
                                    <p class="text-muted mb-4">
                                        {{ 'tinect-passkeys.profile.empty'|trans|sw_sanitize }}
                                    </p>
                                {% endblock %}
                            {% endif %}
                        {% endblock %}

                        {% block page_account_passkeys_register %}
                            {# with a disabled password login, adding a passkey is confirmed with an existing passkey instead of the password #}
                            {% set tinectPasskeyRegisterOptions = {
                                optionsUrl: path('frontend.tinect-passkeys.register.options'),
                                registerUrl: path('frontend.tinect-passkeys.register'),
                                confirmOptionsUrl: tinectPasswordLoginDisabled ? path('frontend.tinect-passkeys.confirm.options') : '',
                                errorMessage: 'tinect-passkeys.register.error'|trans|striptags,
                            notAllowedMessage: 'tinect-passkeys.register.errorNotAllowed'|trans|striptags,
                            } %}

                            <div class="tinect-passkey-register-container">
                                <form class="tinect-passkey-register"
                                      data-tinect-passkey-register="true"
                                      data-tinect-passkey-register-options="{{ tinectPasskeyRegisterOptions|json_encode }}">
                                    <h3 class="h6 fw-bold mb-3">{{ 'tinect-passkeys.register.title'|trans|sw_sanitize }}</h3>

                                    <div class="row g-2 align-items-end">
                                        <div class="form-group col-md">
                                            <label class="form-label" for="tinectPasskeyName">
                                                {{ 'tinect-passkeys.register.nameLabel'|trans|sw_sanitize }}
                                            </label>
                                            <input type="text"
                                                   class="form-control"
                                                   id="tinectPasskeyName"
                                                   name="name"
                                                   maxlength="255"
                                                   placeholder="{{ 'tinect-passkeys.register.namePlaceholder'|trans|striptags }}">
                                        </div>

                                        {% if not tinectPasswordLoginDisabled %}
                                            <div class="form-group col-md">
                                                <label class="form-label" for="tinectPasskeyPassword">
                                                    {{ 'tinect-passkeys.register.passwordLabel'|trans|sw_sanitize }}{{ 'general.required'|trans|sw_sanitize }}
                                                </label>
                                                <input type="password"
                                                       class="form-control"
                                                       id="tinectPasskeyPassword"
                                                       name="password"
                                                       autocomplete="current-password"
                                                       required>
                                            </div>
                                        {% endif %}

                                        <div class="form-group col-md-auto">
                                            <button type="submit" class="btn btn-primary w-100">
                                                {{ 'tinect-passkeys.register.button'|trans|sw_sanitize }}
                                            </button>
                                        </div>
                                    </div>

                                    {% if tinectPasswordLoginDisabled %}
                                        <p class="mt-2 mb-0 small text-muted">{{ 'tinect-passkeys.register.confirmWithPasskey'|trans|sw_sanitize }}</p>
                                    {% endif %}

                                    <div class="tinect-passkey-register-error alert alert-danger mt-2 mb-0 d-none" role="alert"></div>
                                    <div class="tinect-passkey-register-unsupported alert alert-warning mt-2 mb-0 d-none" role="alert">
                                        {{ 'tinect-passkeys.register.unsupported'|trans|sw_sanitize }}
                                    </div>
                                </form>
                            </div>
                        {% endblock %}
                    </div>
                </div>

                {% block page_account_passkeys_password_login %}
                    {% if tinectPasskeys is not empty %}
                        {% set tinectPasswordLoginAction = tinectPasswordLoginDisabled ? 'enable' : 'disable' %}

                        <div class="card tinect-passkey-password-login mb-4">
                            <div class="card-body">
                                {% block page_account_passkeys_password_login_header %}
                                    <h2 class="card-title d-flex flex-wrap align-items-center gap-2">
                                        {{ 'tinect-passkeys.passwordLogin.title'|trans|sw_sanitize }}

                                        {% if tinectPasswordLoginDisabled %}
                                            <span class="badge rounded-pill text-bg-success">
                                                {{ 'tinect-passkeys.passwordLogin.statusDisabled'|trans|sw_sanitize }}
                                            </span>
                                        {% else %}
                                            <span class="badge rounded-pill text-bg-warning">
                                                {{ 'tinect-passkeys.passwordLogin.statusEnabled'|trans|sw_sanitize }}
                                            </span>
                                        {% endif %}
                                    </h2>
                                {% endblock %}

                                <p>
                                    {% if tinectPasswordLoginDisabled %}
                                        {{ 'tinect-passkeys.passwordLogin.disabledInfo'|trans|sw_sanitize }}
                                    {% else %}
                                        {{ 'tinect-passkeys.passwordLogin.description'|trans|sw_sanitize }}
                                    {% endif %}
                                </p>

                                <div class="card-actions">
                                    <button type="button"
                                            class="btn {{ tinectPasswordLoginDisabled ? 'btn-outline-secondary' : 'btn-outline-primary' }}"
                                            data-bs-toggle="modal"
                                            data-bs-target="#tinectPasswordLoginModal">
                                        {{ ('tinect-passkeys.passwordLogin.' ~ tinectPasswordLoginAction)|trans|sw_sanitize }}
                                    </button>
                                </div>
                            </div>
                        </div>

                        {% block page_account_passkeys_password_login_modal %}
                            <div class="modal fade"
                                 id="tinectPasswordLoginModal"
                                 tabindex="-1"
                                 aria-labelledby="tinectPasswordLoginModalTitle"
                                 aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h2 class="modal-title h5" id="tinectPasswordLoginModalTitle">
                                                {{ ('tinect-passkeys.passwordLogin.' ~ tinectPasswordLoginAction)|trans|sw_sanitize }}
                                            </h2>
                                            <button type="button"
                                                    class="btn-close"
                                                    data-bs-dismiss="modal"
                                                    aria-label="{{ 'global.default.close'|trans|striptags }}"></button>
                                        </div>

                                        <div class="modal-body">
                                            <p>{{ ('tinect-passkeys.passwordLogin.' ~ tinectPasswordLoginAction ~ 'ConfirmText')|trans|sw_sanitize }}</p>
                                            <p class="mb-0 small text-muted">{{ 'tinect-passkeys.passwordLogin.confirmWithPasskey'|trans|sw_sanitize }}</p>
                                            <div class="tinect-passkey-confirm-error alert alert-danger mt-3 mb-0 d-none" role="alert"></div>
                                        </div>

                                        <div class="modal-footer">
                                            <button type="button"
                                                    class="btn btn-secondary"
                                                    data-bs-dismiss="modal">
                                                {{ 'tinect-passkeys.delete.cancel'|trans|sw_sanitize }}
                                            </button>

                                            <form action="{{ path('frontend.tinect-passkeys.password-login') }}"
                                                  method="post"
                                                  data-tinect-passkey-confirm="true"
                                                  data-tinect-passkey-confirm-options="{{ tinectPasskeyConfirmOptions|json_encode }}">
                                                <input type="hidden" name="disabled" value="{{ tinectPasswordLoginDisabled ? '0' : '1' }}">
                                                <button type="submit" class="btn btn-primary">
                                                    {{ ('tinect-passkeys.passwordLogin.' ~ tinectPasswordLoginAction ~ 'Confirm')|trans|sw_sanitize }}
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endblock %}
                    {% endif %}
                {% endblock %}
            {% endblock %}
        </div>
    {% endblock %}
{% endblock %}
